# MemexLab runner config — copy to .env and `source` it (or export these in your shell).
# Pick ONE provider block. The runner switches backend on MEMEX_PROVIDER alone.

# ── Option A: hosted API (Anthropic) ───────────────────────────────────────
# MEMEX_PROVIDER=anthropic
# MEMEX_MODEL=claude-sonnet-4-5          # set to your provider's current model
# ANTHROPIC_API_KEY=sk-ant-...           # set in your shell; do NOT commit it

# ── Option B: hosted API (OpenAI) ──────────────────────────────────────────
# MEMEX_PROVIDER=openai
# MEMEX_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# ── Option C: fully local model (Ollama / vLLM / LM Studio) ────────────────
# Self-hosted, air-gapped — nothing leaves the machine.
# First: `ollama serve` and `ollama pull llama3.1`  (or run vLLM with --api-key)
# MEMEX_PROVIDER=local
# MEMEX_MODEL=llama3.1
# MEMEX_BASE_URL=http://localhost:11434/v1   # Ollama default; vLLM: http://localhost:8000/v1
# MEMEX_API_KEY=local                        # local servers ignore this

# Workspace (the vault the agent operates). Override per-run with --vault.
# MEMEX_VAULT=examples/fake-vault
